__pycache__/
*.pyc
~$*.xlsx

# Cache de download de tools/gerar_bairros_municipios.py (shapefile do
# IBGE) — recriado sozinho na próxima vez que o script rodar.
/tools/.cache/

# Clone antigo usado para publicar no GitHub (repo git aninhado)
/.publish-agricultura/

# Planilhas de origem: contem CPF, telefone, data de nascimento e e-mail.
# Ficam so na maquina de quem gera os dados. Os arquivos publicados
# (js/dados-*.js) sao gerados a partir delas ja sem esses campos.
DEAGRO.xlsx
mecanizacao26.xlsx
*.xlsx

# Chave service_role do Supabase (acesso total ao banco) — só existe no
# servidor. Veja admin_config.example.php e database/CONFIGURAR-ADMIN.md.
admin_config.php

# Cache local da Supabase CLI
/supabase/.temp/

# Termos de VPN gerados (PDFs com CPF, telefone e e-mail das pessoas) — nunca publicar.
/termos-vpn/

# Ponte do Drive com o segredo preenchido (gerada a partir de drive/upload-drive.gs) — nunca publicar.
/drive/*.local.gs
